<% layout("/layouts/boilerplate") %>
<body>
  <div class="row mt-3">
    <div class="col-8 offset-2 mb-3">
      <h3>Listing Details :</h3>
    </div>

    <div class="card show-card col-6">
      <img
        src="<%= listing.image.url %>"
        alt="listing_image"
        class="card-img-top show-img"
      />
      <div class="card-body">
        <p class="card-text mt-3">
          <b> <%= listing.title %> </b> <br />
          <b>Description : </b> <%= listing.description %> <br />
          <b>Price : </b>&#8377; <%= listing.price.toLocaleString("en-IN") %>
          <br />
          <b>Location : </b><%= listing.location %> <br />
          <b>Country : </b><%= listing.country %> <br />
        </p>
      </div>
    </div>

    <br />
    <div class="btns col-8 mb-5 ">
      <a href="/listings/<%= listing._id %>/edit" class="btn btn-dark add-btn   ">Edit Listing</a> 
      <form method="POST" action="/listings/<%=listing._id%>?_method=DELETE">
        <button class="btn btn-dark add-btn">Delete listing</button>
      </form>
    </div>
  </div>
</body>
